  "policies": {
    "p-38pid60nsz": {
      "id": "p-38pid60nsz",
      "name": "DenyOutsideEurope",
      "description": "Only eu-west-1 and eu-central-1 may be used",
      "type": "SERVICE_CONTROL_POLICY",
      "awsManaged": false,
      "content": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Deny",
            "NotAction": [
              "iam:*",
              "organizations:*",
              "sts:*"
            ],
            "Resource": "*",
            "Condition": {
              "StringNotEquals": {
                "aws:RequestedRegion": [
                  "eu-west-1",
                  "eu-central-1"
                ]
              }
            }
          }
        ]
      }
    }
  },
