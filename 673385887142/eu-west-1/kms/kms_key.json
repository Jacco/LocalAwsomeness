  "arn:aws:kms:eu-west-1:673385887142:key/4bfe61d2-8e38-425b-ace5-ad99e56c67d1": {
    "key_id": "4bfe61d2-8e38-425b-ace5-ad99e56c67d1",
    "has_policy": true,
    "key_policy": {
      "Version": "2012-10-17",
      "Id": "auto-acm-4",
      "Statement": [
        {
          "Sid": "Allow creation of decryption grants",
          "Effect": "Allow",
          "Principal": {
            "AWS": "*"
          },
          "Action": "kms:CreateGrant",
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "kms:CallerAccount": "673385887142",
              "kms:ViaService": "acm.eu-west-1.amazonaws.com"
            },
            "ForAllValues:StringEquals": {
              "kms:GrantOperations": "Decrypt"
            },
            "Bool": {
              "kms:GrantIsForAWSResource": "true"
            }
          }
        },
        {
          "Sid": "Allow creation of encryption grant",
          "Effect": "Allow",
          "Principal": {
            "AWS": "*"
          },
          "Action": "kms:CreateGrant",
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "kms:CallerAccount": "673385887142",
              "kms:ViaService": "acm.eu-west-1.amazonaws.com"
            },
            "ForAllValues:StringEquals": {
              "kms:GrantOperations": [
                "Encrypt",
                "ReEncryptFrom",
                "ReEncryptTo"
              ]
            },
            "Bool": {
              "kms:GrantIsForAWSResource": "true"
            }
          }
        },
        {
          "Sid": "Allowed operations for the key owner",
          "Effect": "Allow",
          "Principal": {
            "AWS": "*"
          },
          "Action": [
            "kms:DescribeKey",
            "kms:ListGrants",
            "kms:RevokeGrant",
            "kms:GetKeyPolicy"
          ],
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "kms:CallerAccount": "673385887142"
            }
          }
        },
        {
          "Sid": "Deny re-encryption to any other key",
          "Effect": "Deny",
          "Principal": {
            "AWS": "*"
          },
          "Action": "kms:ReEncrypt*",
          "Resource": "*",
          "Condition": {
            "Bool": {
              "kms:ReEncryptOnSameKey": "false"
            }
          }
        },
        {
          "Sid": "Allow decrypt",
          "Effect": "Allow",
          "Principal": {
            "AWS": "*"
          },
          "Action": "kms:Decrypt",
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "kms:CallerAccount": "673385887142",
              "kms:ViaService": "acm.eu-west-1.amazonaws.com"
            }
          }
        }
      ]
    }
  },
