    "arn": "arn:aws:s3:::codepipeline-eu-west-1-935506072769",
    "region": "eu-west-1",
    "has_policy": true,
    "policy": {
      "Version": "2012-10-17",
      "Id": "SSEAndSSLPolicy",
      "Statement": [
        {
          "Sid": "DenyUnEncryptedObjectUploads",
          "Effect": "Deny",
          "Principal": "*",
          "Action": "s3:PutObject",
          "Resource": "arn:aws:s3:::codepipeline-eu-west-1-935506072769/*",
          "Condition": {
            "StringNotEquals": {
              "s3:x-amz-server-side-encryption": "aws:kms"
            }
          }
        },
        {
          "Sid": "DenyInsecureConnections",
          "Effect": "Deny",
          "Principal": "*",
          "Action": "s3:*",
          "Resource": "arn:aws:s3:::codepipeline-eu-west-1-935506072769/*",
          "Condition": {
            "Bool": {
              "aws:SecureTransport": "false"
            }
          }
        }
      ]
    }
  },
